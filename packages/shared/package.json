{
  "name": "@zoeymind/shared",
  "version": "1.0.0",
  "description": "共享类型和验证 schemas",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./schemas": {
      "import": "./src/schemas/index.ts",
      "types": "./src/schemas/index.ts"
    },
    "./data": {
      "import": "./src/data/index.ts",
      "types": "./src/data/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./schemas": "./dist/schemas/index.js",
      "./data": "./dist/data/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.29.1"
  }
}
