{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZoeyMind",
  "version": "0.1.0",
  "identifier": "com.zoeymind.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @zoeymind-desktop/web dev",
    "beforeBuildCommand": "pnpm --filter @zoeymind-desktop/web build"
  },
  "app": {
    "windows": [
      {
        "title": "ZoeyMind",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
