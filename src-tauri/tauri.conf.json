{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZoeyMind",
  "version": "0.0.0",
  "identifier": "com.zoeymind.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @zoeymind-desktop/web dev",
    "beforeBuildCommand": "pnpm --filter @zoeymind-desktop/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZoeyMind",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ffffff",
        "visible": false,
        "trafficLightPosition": { "x": 12, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "document-icons/zoeymind-document.icns": "zoeymind-document.icns",
      "document-icons/zoeymind-document.ico": "zoeymind-document.ico"
    },
    "fileAssociations": [
      {
        "name": "ZoeyMind Document",
        "ext": ["zmind"],
        "description": "ZoeyMind 思维导图文件",
        "role": "Editor",
        "mimeType": "application/x-zoeymind",
        "exportedType": {
          "identifier": "com.zoeymind.desktop.document",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    }
  }
}
